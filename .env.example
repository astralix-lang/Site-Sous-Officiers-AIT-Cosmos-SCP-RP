# Copiez ce fichier vers .env.local puis renseignez les webhooks Discord.
# Ne publiez jamais le fichier .env.local et ne partagez pas ses valeurs.

DISCORD_WEBHOOK_RECOMMENDATION=
DISCORD_WEBHOOK_PCS_EXP=
DISCORD_WEBHOOK_OBSERVATION_HDR=
DISCORD_WEBHOOK_OBSERVATION_SO=
DISCORD_WEBHOOK_SERGEANT_REPORT=

# Base Supabase des comptes partagés. Ces valeurs doivent rester côté serveur.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Connexion Discord (OAuth2). À renseigner dans les variables d'environnement Vercel.
# L'adresse doit être identique à celle déclarée dans le portail développeur Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://votre-domaine/api/auth/discord/callback
# Facultatif : identifiant Discord de l'Admin existant si son e-mail Discord diffère de son e-mail du portail.
# À retirer après sa première connexion réussie.
DISCORD_BOOTSTRAP_USER_ID=
DISCORD_BOOTSTRAP_GRADE=Sergent
